#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ { quick_tap_ms = <200>; };

/ {
    behaviors {
        LShift_kp: LShift_kp {
            compatible = "zmk,behavior-hold-tap";
            label = "LSHIFT_KP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            hold-trigger-key-positions = <29 25 15 5 6 16 26 27 17 7 8 18 28 19 9>;
            flavor = "balanced";
            hold-trigger-on-release;
        };

        cursor_left: cursor_left {
            compatible = "zmk,behavior-tap-dance";
            label = "CURSOR_LEFT";
            #binding-cells = <0>;
            bindings = <&kp LEFT_ARROW>, <&kp LA(LEFT_ARROW)>, <&kp HOME>;

            tapping-term-ms = <180>;
        };

        cursor_right: cursor_right {
            compatible = "zmk,behavior-tap-dance";
            label = "CURSOR_RIGHT";
            #binding-cells = <0>;
            bindings = <&kp RIGHT>, <&kp LA(RIGHT)>, <&kp END>;

            tapping-term-ms = <180>;
        };

        Umlauts: Umlauts {
            compatible = "zmk,behavior-tap-dance";
            label = "UMLAUTS";
            #binding-cells = <0>;
            bindings = <&kp U>, <&kp RA(U)>;

            tapping-term-ms = <180>;
        };

        hochkomma: hochkomma {
            compatible = "zmk,behavior-tap-dance";
            label = "HOCHKOMMA";
            #binding-cells = <0>;
            bindings = <&kp SEMICOLON>, <&kp SQT>, <&kp DQT>;

            tapping-term-ms = <270>;
        };

        RShift_kp: RShift_kp {
            compatible = "zmk,behavior-hold-tap";
            label = "RSHIFT_KP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <24 14 4 3 13 23 22 12 2 1 11 21 20 10 0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERT {
            /* GAME
 *
 * ,----------------------------------.                      ,----------------------------------.
 * |  ESC |   Q  |   W  |   E  |   R  |                      |      |      |      |      |      |
 * |------+------+------+------+------|                      |------+------+------+------+------|
 * |Shift |   A  |   S  |   D  |   F  |                      |      |      |      |      |      |
 * |------+------+------+------+------|  ,-----.    ,-----.  |------+------+------+------+------|
 * | Ctrl |   Z  |   X  |   C  |   V  |  |CPSLK|    |NUMLK|  |      |      |      |      |      |
 * `----------------------------------'  `-----'    `-----'  `----------------------------------'
 *          ,-----.   ,--------------------.            ,--------------------.   ,-----. 
 *          |  1  |   |  TAB  | SPACE |    |            |       | BS |       |   |  4  |
 *          `-----'   `--------------------'            `--------------------'   `-----'
 */

            bindings = <
&kp Q                    &kp W             &kp E         &kp R      &kp T             &kp Z   &Umlauts  &kp I      &kp O          &kp P
&kp A                    &kp S             &kp D         &kp F      &kp G             &kp H   &kp J     &kp K      &kp L          &hochkomma
&LShift_kp LEFT_SHIFT Y  &kp X             &kp C         &kp V      &kp B             &kp N   &kp M     &kp COMMA  &kp PERIOD     &RShift_kp RIGHT_SHIFT SLASH
&trans                   &kp LEFT_CONTROL  &kp LEFT_ALT  &kp SPACE  &kp LC(UP_ARROW)  &trans  &mo 2     &mo 1      &kp RIGHT_GUI  &trans
            >;

            sensor-bindings = <
                            &inc_dec_kp PAGE_DOWN PAGE_UP
                            &inc_dec_kp C_VOL_DN C_VOL_UP
                            &inc_dec_kp DOWN UP
                            &inc_dec_kp C_AC_ZOOM_IN C_AC_ZOOM_OUT
            >;
        };

        number_layer {
            /* NUM
 *
 * ,----------------------------------.                      ,----------------------------------.
 * |  ESC |  F10 |  F11 |  F12 |	  	|                      |   /  |   7  |   8  |   9  |   -  |
 * |------+------+------+------+------|                      |------+------+------+------+------|
 * |  GUI |  ALT | CTRL | SHIFT|  TAB |                      |   =  |   4  |   5  |   6  |   +  |
 * |------+------+------+------+------|  ,-----.    ,-----.  |------+------+------+------+------|
 * |  RET |  F7  |  F8  |  F9  |      |  |CPSLK|    |NUMLK|  |   0  |   1  |   2  |   3  |   *  |
 * `----------------------------------'  `-----'    `-----'  `----------------------------------'
 *          ,-----.   ,--------------------.            ,--------------------.   ,-----. 
 *          |  1  |   | NUM | SPACE |  	   |            |      | DEL |  NAV  |   |  4  |
 *          `-----'   `--------------------'            `--------------------'   `-----'
 */

            bindings = <
&kp ESC         &kp BACKSPACE   &kp UP_ARROW    &kp DELETE       &kp PG_UP  &kp KP_PLUS  &kp N7  &kp N8  &kp N9  &kp KP_DIVIDE
&kp TAB         &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none      &kp MINUS    &kp N4  &kp N5  &kp N6  &kp KP_ASTERISK
&kp LEFT_SHIFT  &trans          &trans          &kp RET          &trans     &kp N0       &kp N1  &kp N2  &kp N3  &mt RIGHT_SHIFT KP_EQUAL
&trans          &trans          &trans          &trans           &trans     &trans       &trans  &trans  &trans  &trans
            >;

            //            sensor-bindings = <
            //                &inc_dec_kp PAGE_DOWN PAGE_UP
            //                &inc_dec_kp C_VOL_DN C_VOL_UP
            //                &inc_dec_kp DOWN UP
            //                &inc_dec_kp LEFT RIGHT
            //            >;
        };

        symbol_layer {
            /* SYM
 *
 * ,----------------------------------.                      ,----------------------------------.
 * |   %  |   @  |   [  |   ]  |   \  |                      |       |     |   ^  |      |      |
 * |------+------+------+------+------|                      |------+------+------+------+------|
 * |   #  |   !  |   (  |   )  |   |  |                      |   _  |   '  |   "  |   ~  |   `  |
 * |------+------+------+------+------|  ,-----.    ,-----.  |------+------+------+------+------|
 * |   $  |      |   {  |   }  |   &  |  |CPSLK|    |NUMLK|  |      |      |      |      |      |
 * `----------------------------------'  `-----'    `-----'  `----------------------------------'
 *          ,-----.   ,--------------------.            ,--------------------.   ,-----. 
 *          |  1  |   | NUM | SPACE |      |            |       | BS |  NAV  |   |  4  |
 *          `-----'   `--------------------'            `--------------------'   `-----'
 */

            bindings = <
&kp PRCNT  &kp AT          &kp LBKT   &kp RBKT       &kp NON_US_BSLH  &trans         &trans    &kp CARET          &trans     &none
&kp HASH   &kp LEFT_BRACE  &kp LPAR   &kp RPAR       &kp RIGHT_BRACE  &kp LC(LS(B))  &kp APOS  &kp DOUBLE_QUOTES  &kp TILDE  &none
&kp DLLR   &kp TILDE       &kp SLASH  &kp BACKSLASH  &kp HASH         &none          &none     &none              &none      &none
&trans     &trans          &trans     &mo 3          &trans           &trans         &trans    &trans             &trans     &trans
            >;

            //            sensor-bindings = <
            //                &inc_dec_kp PAGE_DOWN PAGE_UP
            //                &inc_dec_kp C_VOL_DN C_VOL_UP
            //                &inc_dec_kp DOWN UP
            //                &inc_dec_kp LEFT RIGHT
            //            >;
        };

        settings_layer {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR  &kp F1  &trans  &trans  &trans  &kp F12
&trans        &trans        &trans        &trans        &trans      &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans      &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans      &trans  &trans  &trans  &trans  &trans
            >;
        };

        Colemac_DH {
            /* Colemak-DH
 *
 * ,----------------------------------.                      ,----------------------------------.
 * |   Q  |   W  |   F  |   P  |   B  |                      |   J  |   L  |   U  |   Y  |   ;  |
 * |------+------+------+------+------|                      |------+------+------+------+------|
 * |   A  |   R  |   S  |   T  |   G  |                      |   M  |   N  |   E  |   I  |   O  |
 * |------+------+------+------+------|  ,-----.    ,-----.  |------+------+------+------+------|
 * |   Z  |   X  |   C  |   D  |   V  |  |CPSLK|    |NUMLK|  |   K  |   H  |   ,  |   .  |   /  |
 * `----------------------------------'  `-----'    `-----'  `----------------------------------'
 *          ,-----.   ,--------------------.            ,--------------------.   ,-----. 
 *          |  1  |   | NUM | SPACE | 	   |            |       | BS |  NAV  |   |  4  |
 *          `-----'   `--------------------'            `--------------------'   `-----'
 */

            bindings = <
&kp Q                    &kp W             &kp F         &kp P      &kp B  &kp J  &kp L  &kp U      &kp Y          &kp SEMI
&kp A                    &kp R             &kp S         &kp T      &kp G  &kp M  &kp N  &kp E      &kp I          &kp O
&LShift_kp LEFT_SHIFT Z  &kp X             &kp C         &kp D      &kp V  &kp K  &kp H  &kp COMMA  &kp DOT        &LShift_kp LEFT_SHIFT SLASH
&none                    &kp LEFT_CONTROL  &kp LEFT_ALT  &kp SPACE  &none  &none  &mo 2  &mo 1      &kp RIGHT_GUI  &none
            >;

            sensor-bindings = <
                            &inc_dec_kp PAGE_DOWN PAGE_UP
                            &inc_dec_kp C_VOL_DN C_VOL_UP
                            &inc_dec_kp DOWN UP
                            &inc_dec_kp LEFT RIGHT
            >;

            //sensor-bindings = <&inc_dec_kp 0 0>, <&inc_dec_kp 0 0>;
        };
    };
};

/ {
    conditional_layers { compatible = "zmk,conditional-layers"; };
};

/ {
    combos {
        compatible = "zmk,combos";

        copy {
            bindings = <&kp LG(C)>;
            key-positions = <12 13>;
            layers = <4 0>;
        };

        past {
            bindings = <&kp RG(V)>;
            key-positions = <2 3>;
            layers = <4 0>;
        };

        delete {
            bindings = <&kp RG(BACKSPACE)>;
            key-positions = <3 4>;
        };

        space_cadet {
            bindings = <&caps_word>;
            key-positions = <10 19>;
            layers = <0 4>;
        };

        Lock_Mac {
            bindings = <&kp LC(RG(Q))>;
            key-positions = <0 1>;
            layers = <0>;
        };

        Input_Alpha {
            bindings = <&Input_Alpha>;
            key-positions = <8 9>;
            layers = <1>;
        };
    };
};

/ {
    macros {
        zed_em_kay: zed_em_kay {
            label = "ZM_zed_em_kay";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_press>,
                <&kp F13 &kp KP_N1 &kp KP_N6 &kp KP_N3>,
                <&macro_release>,
                <&kp LALT>;
        };

        tog_1_on_off: tog_1_on_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&tog 1>, <&macro_release>, <&tog 1>;

            label = "TOG_1_ON_OFF";
        };

        Input_Alpha: Input_Alpha {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(N) &kp E &kp X &kp I &kp G &kp O &kp LS(T) &kp O &kp N &kp O &kp R &kp N2 &kp N0 &kp N2 &kp N6>;
            label = "INPUT_ALPHA";
        };
    };
};
