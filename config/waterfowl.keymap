#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

&lt { quick_tap_ms = <200>; };

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            /* Colemak-DH
 *
 * ,----------------------------------.                      ,----------------------------------.
 * |   Q  |   W  |   F  |   P  |   B  |                      |   J  |   L  |   U  |   Y  |   ;  |
 * |------+------+------+------+------|                      |------+------+------+------+------|
 * |   A  |   R  |   S  |   T  |   G  |                      |   M  |   N  |   E  |   I  |   O  |
 * |------+------+------+------+------|  ,-----.    ,-----.  |------+------+------+------+------|
 * |   Z  |   X  |   C  |   D  |   V  |  |CPSLK|    |NUMLK|  |   K  |   H  |   ,  |   .  |   /  |
 * `----------------------------------'  `-----'    `-----'  `----------------------------------'
 *          ,-----.   ,--------------------.            ,--------------------.   ,-----. 
 *          |  1  |   | NUM | SPACE | 	   |            |       | BS |  NAV  |   |  4  |
 *          `-----'   `--------------------'            `--------------------'   `-----'
 */

            bindings = <
&kp Q   &kp W         &kp F         &kp P         &kp B     &kp J   &kp L         &kp U         &kp Y         &kp SEMI
&kp A   &kp R         &kp S         &kp T         &kp G     &kp M   &kp N         &kp E         &kp I         &kp O
&kp Z   &kp X         &kp C         &kp D         &kp V     &kp K   &kp H         &kp COMMA     &kp DOT       &kp FSLH
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans    &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_AC_SCROLL_UP C_AC_SCROLL_DOWN>;
        };

        number_layer {
            /* NUM
 *
 * ,----------------------------------.                      ,----------------------------------.
 * |  ESC |  F10 |  F11 |  F12 |	  	|                      |   /  |   7  |   8  |   9  |   -  |
 * |------+------+------+------+------|                      |------+------+------+------+------|
 * |  GUI |  ALT | CTRL | SHIFT|  TAB |                      |   =  |   4  |   5  |   6  |   +  |
 * |------+------+------+------+------|  ,-----.    ,-----.  |------+------+------+------+------|
 * |  RET |  F7  |  F8  |  F9  |      |  |CPSLK|    |NUMLK|  |   0  |   1  |   2  |   3  |   *  |
 * `----------------------------------'  `-----'    `-----'  `----------------------------------'
 *          ,-----.   ,--------------------.            ,--------------------.   ,-----. 
 *          |  1  |   | NUM | SPACE |  	   |            |      | DEL |  NAV  |   |  4  |
 *          `-----'   `--------------------'            `--------------------'   `-----'
 */

            bindings = <
&kp ESC         &kp BACKSPACE   &kp UP_ARROW    &kp DELETE       &trans     &kp KP_PLUS   &kp N7        &kp N8        &kp N9        &kp KP_DIVIDE
&kp TAB         &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp TAB    &kp MINUS     &kp N4        &kp N5        &kp N6        &kp KP_ASTERISK
&kp LEFT_SHIFT  &trans          &trans          &kp RET          &trans     &kp N0        &kp N1        &kp N2        &kp N3        &kp KP_EQUAL
&kp NUMBER_1    &kp NUMBER_2    &kp NUMBER_3    &kp NUMBER_4     &kp N5     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5
            >;

            sensor-bindings = <&inc_dec_kp PAGE_UP PAGE_DOWN &inc_dec_kp TAB LS(TAB)>;
        };

        symbol_layer {
            /* SYM
 *
 * ,----------------------------------.                      ,----------------------------------.
 * |   %  |   @  |   [  |   ]  |   \  |                      |       |     |   ^  |      |      |
 * |------+------+------+------+------|                      |------+------+------+------+------|
 * |   #  |   !  |   (  |   )  |   |  |                      |   _  |   '  |   "  |   ~  |   `  |
 * |------+------+------+------+------|  ,-----.    ,-----.  |------+------+------+------+------|
 * |   $  |      |   {  |   }  |   &  |  |CPSLK|    |NUMLK|  |      |      |      |      |      |
 * `----------------------------------'  `-----'    `-----'  `----------------------------------'
 *          ,-----.   ,--------------------.            ,--------------------.   ,-----. 
 *          |  1  |   | NUM | SPACE |      |            |       | BS |  NAV  |   |  4  |
 *          `-----'   `--------------------'            `--------------------'   `-----'
 */

            bindings = <
&kp PRCNT  &kp AT       &kp LBKT   &kp RBKT  &kp NON_US_BSLH    &trans       &trans    &kp CARET          &trans     &trans
&kp HASH   &kp EXCL     &kp LPAR   &kp RPAR  &kp PIPE           &kp UNDER    &kp APOS  &kp DOUBLE_QUOTES  &kp TILDE  &kp GRAVE
&kp DLLR   &zed_em_kay  &kp LBRC   &kp RBRC  &kp AMPS           &trans       &trans    &trans             &trans     &studio_unlock
&trans     &mo 1        &kp SPACE  &kp TAB   &kp CLCK           &kp KP_NLCK  &trans    &kp BSPC           &mo 0      &out OUT_BLE
            >;

            sensor-bindings = <&inc_dec_kp PAGE_UP PAGE_DOWN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        game_layer {
            /* GAME
 *
 * ,----------------------------------.                      ,----------------------------------.
 * |  ESC |   Q  |   W  |   E  |   R  |                      |      |      |      |      |      |
 * |------+------+------+------+------|                      |------+------+------+------+------|
 * |Shift |   A  |   S  |   D  |   F  |                      |      |      |      |      |      |
 * |------+------+------+------+------|  ,-----.    ,-----.  |------+------+------+------+------|
 * | Ctrl |   Z  |   X  |   C  |   V  |  |CPSLK|    |NUMLK|  |      |      |      |      |      |
 * `----------------------------------'  `-----'    `-----'  `----------------------------------'
 *          ,-----.   ,--------------------.            ,--------------------.   ,-----. 
 *          |  1  |   |  TAB  | SPACE |    |            |       | BS |       |   |  4  |
 *          `-----'   `--------------------'            `--------------------'   `-----'
 */

            bindings = <
&kp ESC    &kp Q    &kp W      &kp E   &kp R       &trans       &trans    &trans     &trans     &trans
&kp LSHFT  &kp A    &kp S      &kp D   &kp F       &trans       &kp LEFT  &kp SPACE  &kp RIGHT  &trans
&kp LCTRL  &kp Z    &kp X      &kp C   &kp V       &trans       &trans    &trans     &trans     &trans
&trans     &kp TAB  &kp SPACE  &trans  &kp CLCK    &kp KP_NLCK  &trans    &kp BSPC   &mo 0      &trans
            >;

            sensor-bindings = <&inc_dec_kp PAGE_UP PAGE_DOWN &inc_dec_kp TAB LS(TAB)>;
        };
    };
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <1 2>;
            then-layer = <2>;
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_game {
            timeout-ms = <50>;
            key-positions = <0 4>;
            bindings = <&to 3>;
        };

        combo_base {
            timeout-ms = <50>;
            key-positions = <5 9>;
            bindings = <&to 0>;
        };
    };
};

/ {
    macros {
        zed_em_kay: zed_em_kay {
            label = "ZM_zed_em_kay";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N6 &kp KP_N3>,
                <&macro_release>,
                <&kp LALT>;
        };
    };
};
